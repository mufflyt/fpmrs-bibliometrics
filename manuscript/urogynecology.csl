<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Urogynecology (AMA-style numeric)</title>
    <id>https://github.com/mufflyt/fpmrs-bibliometrics/urogynecology</id>
    <link href="https://github.com/mufflyt/fpmrs-bibliometrics" rel="self"/>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <summary>Numeric superscript style approximating the AMA Manual of Style,
      which the journal Urogynecology (Wolters Kluwer) follows. Verify against
      the current author instructions before submission; to use the official
      style instead, drop in american-medical-association.csl from
      https://github.com/citation-style-language/styles.</summary>
    <updated>2026-08-17T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">
      This work is licensed under a Creative Commons Attribution-ShareAlike 3.0
      License.
    </rights>
  </info>

  <macro name="author">
    <names variable="author" suffix=".">
      <name sort-separator=" " initialize-with="" name-as-sort-order="all"
            delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=", "/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <text variable="title"/>
  </macro>

  <macro name="container">
    <text variable="container-title" form="short" strip-periods="true"/>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="locators">
    <group delimiter=":">
      <text variable="volume"/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi:"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout delimiter="," vertical-align="sup">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" suffix="."/>
      <group delimiter=" ">
        <text macro="author"/>
        <text macro="title" suffix="."/>
        <group delimiter=". ">
          <text macro="container"/>
          <group delimiter=";">
            <text macro="issued"/>
            <text macro="locators"/>
          </group>
          <text macro="access"/>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
